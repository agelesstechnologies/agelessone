{
  "name": "@ageless/backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "ts-node-dev -r dotenv/config --respawn --transpile-only src/main.ts",
    "test": "vitest run",
    "boundaries": "depcruise src --config .dependency-cruiser.cjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:reset": "node scripts/db-reset.mjs && drizzle-kit migrate",
    "db:seed": "node scripts/db-seed.mjs",
    "hrms:daily": "node -r dotenv/config dist/jobs/hrms-daily.js",
    "tickets:daily": "node -r dotenv/config dist/jobs/tickets-daily.js"
  },
  "dependencies": {
    "@ageless/shared": "workspace:*",
    "@asteasolutions/zod-to-openapi": "7.3.4",
    "@nestjs/common": "10.4.4",
    "@nestjs/core": "10.4.4",
    "@nestjs/jwt": "10.2.0",
    "@nestjs/platform-express": "10.4.4",
    "@nestjs/swagger": "7.4.2",
    "bcrypt": "5.1.1",
    "drizzle-orm": "0.44.4",
    "pg": "8.12.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.1",
    "zod": "3.23.8"
  },
  "devDependencies": {
    "@types/bcrypt": "5.0.2",
    "@types/node": "22.7.5",
    "@types/pg": "8.11.10",
    "@types/supertest": "7.2.1",
    "dependency-cruiser": "16.4.2",
    "dotenv": "16.4.5",
    "drizzle-kit": "0.31.4",
    "supertest": "7.3.1",
    "ts-node-dev": "2.0.0",
    "typescript": "5.6.3",
    "vitest": "2.1.3"
  }
}
