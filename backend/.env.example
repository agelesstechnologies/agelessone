DATABASE_URL=postgres://ageless:ageless_dev@localhost:5434/ageless_dev
TEST_DATABASE_URL=postgres://ageless:ageless_dev@localhost:5434/ageless_test
PORT=3000
# Signs login tokens. Any long random text; different on every server, never committed.
JWT_SECRET=change-me-to-a-long-random-value

# API docs at /api/docs and /api/docs.json (on by default). Set to off to hide them, e.g. on a public server.
# API_DOCS=off

# Addresses of punch locations (reverse geocoding). none = store coordinates only; the addresses:retry job fills in
# addresses once a provider is set. nominatim (OpenStreetMap; set GEOCODING_URL for your own server) or google (needs a key).
GEOCODING_PROVIDER=none
# GEOCODING_URL=https://nominatim.openstreetmap.org
# GEOCODING_API_KEY=
# GEOCODING_TIMEOUT_MS=3000

# Sign-in limits: failed sign-ins per account and per IP address within the window lock that account / IP briefly.
# LOGIN_MAX_FAILURES=5
# LOGIN_MAX_FAILURES_PER_IP=30
# LOGIN_WINDOW_MINUTES=15
# LOGIN_LOCKOUT_MINUTES=15
# Behind a reverse proxy (IIS, nginx) set how many proxies are in front, so the client's real address is used (else unset).
# TRUST_PROXY=1
# Sign-in codes (first login, forgot password) are emailed. console = printed in the server console (development);
# smtp = real email (e.g. a Google Workspace or Zoho mailbox such as no-reply@agelessind.com).
EMAIL_PROVIDER=console
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Ageless <no-reply@agelessind.com>
# The web address put in welcome emails (where staff open the app).
APP_URL=http://localhost:5173
# Sign-in codes to the login phone. console = printed in the server console (development); whatsapp = Meta's WhatsApp
# Cloud API (settings below). A real SMS provider (MSG91, Fast2SMS, Twilio) needs DLT registration in India first.
SMS_PROVIDER=console
# WhatsApp (SMS_PROVIDER=whatsapp), from Meta's developer app > WhatsApp > API Setup.
# Pilot with Meta's test number: it delivers only to the (up to 5) numbers added to its recipient list there, and the
# temporary token lasts 24 hours. Production needs our own business number and a permanent System User token.
# Phone number ID of the sending number (not the phone number itself). Required.
# WHATSAPP_PHONE_ID=
# Access token. Required; never commit it.
# WHATSAPP_TOKEN=
# Name of the APPROVED Authentication template (one {{1}} code and a copy-code button) that carries the code.
# hello_world = Meta's test template: proves the connection only, the code is NOT delivered.
# WHATSAPP_CODE_TEMPLATE=ageless_auth_code
# Language code the template was approved in (hello_world always uses en_US).
# WHATSAPP_TEMPLATE_LANG=en
# WHATSAPP_API_VERSION=v23.0
# Optional approved template (no parameters) for the welcome message; unset = no welcome on WhatsApp (free text is refused).
# WHATSAPP_WELCOME_TEMPLATE=
# WHATSAPP_TIMEOUT_MS=8000
# DEVELOPMENT ONLY: show sign-in codes on screen, to test without a mailbox or SMS. NEVER set this on a real server.
# DEV_SHOW_CODES=true
