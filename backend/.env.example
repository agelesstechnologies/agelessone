DATABASE_URL=postgres://ageless:ageless_dev@localhost:5434/ageless_dev
TEST_DATABASE_URL=postgres://ageless:ageless_dev@localhost:5434/ageless_test
PORT=3000
# Signs login tokens. Any long random text; different on every server, never committed.
JWT_SECRET=change-me-to-a-long-random-value

# API docs at /api/docs and /api/docs.json (on by default). Set to off to hide them, e.g. on a public server.
# API_DOCS=off

# Addresses of punch locations (reverse geocoding). none = store coordinates only; the addresses:retry job fills in
# addresses once a provider is set. nominatim (OpenStreetMap; set GEOCODING_URL for your own server) or google (needs a key).
GEOCODING_PROVIDER=none
# GEOCODING_URL=https://nominatim.openstreetmap.org
# GEOCODING_API_KEY=
# GEOCODING_TIMEOUT_MS=3000

# Sign-in limits: failed sign-ins per account and per IP address within the window lock that account / IP briefly.
# LOGIN_MAX_FAILURES=5
# LOGIN_MAX_FAILURES_PER_IP=30
# LOGIN_WINDOW_MINUTES=15
# LOGIN_LOCKOUT_MINUTES=15
# Behind a reverse proxy (IIS, nginx) set how many proxies are in front, so the client's real address is used (else unset).
# TRUST_PROXY=1
# Sign-in codes (first login, forgot password) are emailed. console = printed in the server console (development);
# smtp = real email (e.g. a Google Workspace or Zoho mailbox such as no-reply@agelessind.com).
EMAIL_PROVIDER=console
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=Ageless <no-reply@agelessind.com>
# The web address put in welcome emails (where staff open the app).
APP_URL=http://localhost:5173
# Sign-in codes by SMS to the login phone. console = printed in the server console (development). A real provider
# (MSG91, Fast2SMS, Twilio) needs DLT registration in India; add it in src/platform/sms.ts once chosen.
SMS_PROVIDER=console
# DEVELOPMENT ONLY: show sign-in codes on screen, to test without a mailbox or SMS. NEVER set this on a real server.
# DEV_SHOW_CODES=true
