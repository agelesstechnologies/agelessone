{
  "name": "ageless",
  "private": true,
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "dev:backend": "pnpm --filter @ageless/backend dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "boundaries": "pnpm --filter @ageless/backend boundaries",
    "db:generate": "pnpm --filter @ageless/backend db:generate",
    "db:migrate": "pnpm --filter @ageless/backend db:migrate",
    "db:reset": "pnpm --filter @ageless/backend db:reset",
    "db:seed": "pnpm --filter @ageless/backend db:seed"
  },
  "devDependencies": {
    "turbo": "2.1.3",
    "typescript": "5.6.3"
  }
}
